{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetShakti Meaningful Change Record",
  "type": "object",
  "required": ["source", "observedAt", "changeType", "impact", "previous", "current"],
  "properties": {
    "source": {"type":"object","required":["name","url"],"properties":{"name":{"type":"string"},"url":{"type":"string","format":"uri"}}},
    "observedAt":{"type":"string","format":"date-time"},
    "changeType":{"enum":["AUCTION_VOLUME","ASSET_MIX","REGULATION","PLATFORM_TERMS","DATA_AVAILABILITY","ACCESS","BIDDER_OBLIGATION","OTHER"]},
    "impact":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "previous":{"type":["string","null"]},
    "current":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "humanReviewRequired":{"type":"boolean"},
    "assetshaktiAction":{"type":"string"}
  }
}