# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB URI for user and analytics data
MONGO_URI="mongodb://localhost:27017/allianceventures"

# Internal token for service-to-service communication
INTERNAL_SERVICE_TOKEN="super_internal_token"

# API URLs for the portfolio ventures
VK_URL="https://vyaparkendra-api-url"
RK_URL="https://rupaykg-api-url"
AK_URL="https://ayushkendra-api-url"

# Production-only security configuration (do not commit real values)
# Store RSA keys in your deployment secret manager; supply PEM content as multiline or escaped \n.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
#
# Evidence intake requires a genuinely durable, access-controlled persistent volume.
# The app refuses production startup unless the operator configures and explicitly confirms this.
# ASSETSHAKTI_EVIDENCE_DIR="/mnt/assetshakti-evidence"
# ASSETSHAKTI_EVIDENCE_STORAGE_MODE="persistent-volume"
# Set true only after verifying persistence across restarts, backups, restricted access and recovery.
# ASSETSHAKTI_EVIDENCE_STORAGE_CONFIRMED="true"
